# syntax=docker/dockerfile:1
# Runtime image for the Harness DSH profile in the target K3s cluster.
# The source context contains sibling `opute-harness/` and `deepseek-harness/`
# directories so the maintained DSH CLI and web bundle stay together.
FROM node:22-bookworm-slim

WORKDIR /workspace
COPY opute-harness /workspace/opute-harness
COPY deepseek-harness /workspace/deepseek-harness

# pnpm may encode workspace links with the developer's absolute checkout path.
# Repair only those links in the image; do not dereference the dependency graph
# (which contains intentional cycles).
RUN find /workspace -type l -exec sh -c '\
      for link do \
        target="$(readlink "$link")"; \
        case "$target" in \
          /home/houman/github/wunderous/opute-harness/*) \
            rel="${target#/home/houman/github/wunderous/opute-harness/}"; \
            rm "$link"; ln -s "/workspace/opute-harness/$rel" "$link" ;; \
          /home/houman/github/wunderous/deepseek-harness/*) \
            rel="${target#/home/houman/github/wunderous/deepseek-harness/}"; \
            rm "$link"; ln -s "/workspace/deepseek-harness/$rel" "$link" ;; \
        esac; \
      done \
    ' sh {} +

WORKDIR /workspace/opute-harness
ENV DSH_ROOT=/workspace/deepseek-harness
ENV OPUTE_HARNESS_PRESET_ROOT=/workspace/opute-harness/packages/bundle-opute-web/presets
ENV OPUTE_MCP_ENDPOINT=https://mcp.opute.io/mcp
ENV OPUTE_HARNESS_PORT=3080
ENV OPUTE_HARNESS_REQUIRE_MCP=1
ENV HOME=/tmp/dsh-home

RUN mkdir -p /tmp/dsh-home
EXPOSE 3080
CMD ["node", "scripts/launch-opute-web.js"]
